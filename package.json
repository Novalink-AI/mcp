  "keywords": [
    "worfilo",
    "mcp",
    "model-context-protocol",
    "claude-code",
    "cursor",
    "antigravity",
    "workflows",
    "ai-agents"
  ],
  "homepage": "https://github.com/Worfilo/mcp#readme",
  "bugs": {
    "url": "https://github.com/Worfilo/mcp/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Worfilo/mcp.git"
  },
  "license": "MIT",
  "type": "module",
  "bin": {
    "worfilo-mcp": "dist/cli.js"
  },
  "files": [
    "dist",
    "skills"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "prepublishOnly": "npm run typecheck && npm test && npm run build"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsup": "^8.5.0",
    "typescript": "^5.9.0",
    "vitest": "^5.0.2"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
